<!-- http://a.tiles.mapbox.com/v4/mapbox.satellite/{z}/{x}/{y}.jpg?access_token=YOUR_MAPBOX_ACCESS_TOKEN -->
<launch>

  <arg name="save_origin" default="false"/>
  <arg name="load_origin" default="true"/>
  <!-- <arg name="ori_lat" default="34.1737883252"/>
  <arg name="ori_lon" default="117.22346778"/>
  <arg name="ori_alt" default="30.0334587097"/> -->

  <!-- 20250119 -->
  <!-- <arg name="ori_lat" default="34.3996313754"/>
  <arg name="ori_lon" default="117.471402751"/>
  <arg name="ori_alt" default="42.6655197144"/> -->

  <!-- <arg name="ori_lat" default="34.3060588541"/>
  <arg name="ori_lon" default="117.267878573"/>
  <arg name="ori_alt" default="36.4955711365"/> 卫星建图定位--> 

  <arg name="ori_lat" default="31.027566418088327"/>
  <arg name="ori_lon" default="121.44104414639337"/>
  <arg name="ori_alt" default="15.90359878540039"/> 

  <!-- 24.607451757450075,118.07943508161559,14.636591911315918 -->

  <node name="path_client_copy" pkg="gnss_localizer" type="path_client_copy.py" output="screen">
  </node>

  <node pkg="gnss_localizer" type="gnss_localizer_trans" name="gnss_localizer_trans" output="screen">
    <param name="save_origin" value="$(arg save_origin)"/>
    <param name="load_origin" value="$(arg load_origin)"/>
    <param name="ori_lat" value="$(arg ori_lat)"/>
    <param name="ori_lon" value="$(arg ori_lon)"/>
    <param name="ori_alt" value="$(arg ori_alt)"/>

    <!-- <remap from="fix" to="gps/fix"/> -->
    <remap from="fix" to="chcnav/devpvt"/>
  </node>

  <!-- <node pkg="rviz" type="rviz" name="rviz1" output="screen"
    args="-d $(find gnss_localizer)/launch/rviz.rviz" required="true">
  </node> -->

</launch>
